# Lead delivery (all optional — the form works without them, logging leads to the
# server console). Copy to `.env` and fill in to enable email + CRM webhook.

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. "PI Physical Therapy <leads@piphysicaltherapy.com>"
LEAD_EMAIL_FROM=
# Internal inbox that receives new appointment requests
LEAD_EMAIL_TO=

# Optional: POST every lead to a CRM / automation webhook
LEAD_WEBHOOK_URL=
