# Lead delivery (all optional — the form works without them, logging leads to the
# server console). Copy to `.env` and fill in to enable email + CRM webhook.

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. "PI Physical Therapy <leads@piphysicaltherapy.com>"
LEAD_EMAIL_FROM=
# Internal inbox that receives new appointment requests
LEAD_EMAIL_TO=

# Optional: POST every lead to a CRM / automation webhook
LEAD_WEBHOOK_URL=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Both optional: with no secret the captcha is not enforced, which keeps local
# development working. Once TURNSTILE_SECRET_KEY is set — as it is in
# production — a missing or invalid token is rejected.
#
# The widget validates the hostname, so its Turnstile site must list
# piphysicaltherapy.com and www.piphysicaltherapy.com. Keys from another
# domain's widget will fail here.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
