---
import { actions } from 'astro:actions';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor } from '../i18n/routes';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.lead;

const privacyHref = hrefFor('privacy', lang);

// Exact wording shown, in this locale. Travels with the lead as the consent
// record, so it must match what the label renders below.
const consentRecord = `${f.smsConsent} ${f.smsConsentSee} ${f.smsConsentPolicy} ${f.smsConsentTail}`;

// Server-side result (no-JS fallback + progressive enhancement).
const result = Astro.getActionResult(actions.lead);
const ok = result && !result.error;
const failed = result && result.error;
---

<div class="rounded-3xl border border-ink/10 bg-paper p-5 shadow-[var(--shadow-soft)] sm:p-8">
  {ok ? (
    <div role="status" class="py-6 text-center">
      <div class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-success-bg text-success">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
      </div>
      <h3 class="display mt-4 text-2xl">{f.successTitle}</h3>
      <p class="mt-2 text-ink-soft">{f.successBody}</p>
    </div>
  ) : (
    <form method="POST" action={actions.lead} data-lead-form class="grid gap-4">
      <h3 class="display text-2xl">{t.contact.formTitle}</h3>

      {failed && (
        <p role="alert" class="rounded-xl bg-danger-bg px-4 py-3 text-sm font-medium text-danger">
          <strong>{f.errorTitle}.</strong> {f.errorBody}
        </p>
      )}

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-semibold text-ink">
          {f.name}
          <input name="name" type="text" required autocomplete="name" class="form-input" />
        </label>
        <label class="grid gap-1.5 text-sm font-semibold text-ink">
          {f.phone}
          <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="form-input" />
        </label>
      </div>

      <label class="grid gap-1.5 text-sm font-semibold text-ink">
        {f.email}
        <input name="email" type="email" required autocomplete="email" inputmode="email" class="form-input" />
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-semibold text-ink">
          {f.service}
          <select name="service" required class="form-input">
            <option value="rehab">{f.serviceOptions.rehab}</option>
            <option value="accident">{f.serviceOptions.accident}</option>
            <option value="other">{f.serviceOptions.other}</option>
          </select>
        </label>
        <label class="grid gap-1.5 text-sm font-semibold text-ink">
          {f.preferredLang}
          <select name="preferredLang" class="form-input">
            <option value="es" selected={lang === 'es'}>{f.langOptions.es}</option>
            <option value="en" selected={lang === 'en'}>{f.langOptions.en}</option>
          </select>
        </label>
      </div>

      <label class="grid gap-1.5 text-sm font-semibold text-ink">
        {f.message}
        <textarea name="message" rows="3" maxlength="1000" class="form-input"></textarea>
      </label>

      {/* SMS consent. `required` blocks submission with JS off too; the button
          state below is only progressive enhancement. The wording is split so
          the Privacy Policy stays a real link inside the label. */}
      <label class="mt-1 flex items-start gap-3 text-xs leading-relaxed text-ink-soft">
        <input
          type="checkbox"
          name="smsConsent"
          required
          data-consent
          class="mt-0.5 h-5 w-5 shrink-0 accent-field-600"
        />
        <span>
          {f.smsConsent}{' '}
          {f.smsConsentSee}{' '}
          <a href={privacyHref} class="underline underline-offset-2 hover:text-ink">{f.smsConsentPolicy}</a>{' '}
          {f.smsConsentTail}
        </span>
      </label>
      <input type="hidden" name="smsConsentText" value={consentRecord} />

      {/* Captcha. Turnstile injects the `cf-turnstile-response` field into this
          form on its own, which the Action reads. Rendered only when a site key
          exists so local development without keys keeps working. */}
      {PUBLIC_TURNSTILE_SITE_KEY && (
        <>
          {/* The widget is a fixed 300px iframe, wider than the card on a small
              phone. The shell clips it and scales it down there instead of
              letting it push the page sideways. */}
          <div class="turnstile-shell">
            <div
              class="cf-turnstile"
              data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
              data-language={lang}
              data-callback="onPtCaptcha"
              data-expired-callback="onPtCaptchaGone"
              data-error-callback="onPtCaptchaGone"
            ></div>
          </div>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )}

      {/* Locale of the submitting page + honeypot */}
      <input type="hidden" name="locale" value={lang} />
      <div aria-hidden="true" class="absolute left-[-9999px] h-0 w-0 overflow-hidden">
        <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button type="submit" data-submit data-sending={f.submitting} class="btn btn-field mt-1 w-full disabled:cursor-not-allowed disabled:opacity-50">{f.submit}</button>
      <p class="text-xs leading-relaxed text-ink-faint">{f.privacyNote}</p>
    </form>
  )}
</div>

{/* Captcha callbacks live in an inline script so they exist before Cloudflare's
    api.js runs, which can resolve the widget before the module below loads. */}
<script is:inline>
  window.__ptCaptchaOk = false;
  window.onPtCaptcha = function () {
    window.__ptCaptchaOk = true;
    document.dispatchEvent(new CustomEvent('pt-captcha-change'));
  };
  window.onPtCaptchaGone = function () {
    window.__ptCaptchaOk = false;
    document.dispatchEvent(new CustomEvent('pt-captcha-change'));
  };
</script>

<script>
  // Progressive enhancement only. Without JS the form still works: `required`
  // on the checkbox blocks submission, and the server re-validates consent and
  // captcha regardless.
  function wire() {
    const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
    if (!form) return;

    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const consent = form.querySelector<HTMLInputElement>('[data-consent]');
    const needsCaptcha = Boolean(form.querySelector('.cf-turnstile'));

    // The button needs consent, and the captcha too when one is rendered.
    const sync = () => {
      if (!btn) return;
      const captchaOk = !needsCaptcha || (window as unknown as { __ptCaptchaOk?: boolean }).__ptCaptchaOk === true;
      btn.disabled = !(consent?.checked && captchaOk);
    };
    consent?.addEventListener('change', sync);
    document.addEventListener('pt-captcha-change', sync);
    sync();

    form.addEventListener('submit', () => {
      if (btn) {
        btn.disabled = true;
        btn.textContent = btn.getAttribute('data-sending') || 'Sending...';
      }
    });
  }
  document.addEventListener('astro:page-load', wire);
</script>
