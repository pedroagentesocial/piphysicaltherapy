---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const steps = t.process.steps;
---

<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
  <div class="reveal max-w-2xl">
    {eyebrow && <p class="eyebrow text-field-700">{eyebrow}</p>}
    <h2 class="display mt-4 text-3xl sm:text-4xl">{title}</h2>
  </div>
  <ol role="list" class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
        <div class="flex items-center gap-3">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-field-50 font-display text-lg font-extrabold text-field-700">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="hidden h-px flex-1 bg-ink/12 lg:block"></span>
        </div>
        <h3 class="mt-4 text-lg font-bold text-ink">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</p>
      </li>
    ))}
  </ol>
</section>
