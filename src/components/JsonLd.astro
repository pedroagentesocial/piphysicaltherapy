---
import { business as b, socialSameAs } from '../data/business';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = Astro.site!;

// schema.org type: "PhysicalTherapy" is a subtype of MedicalBusiness /
// MedicalOrganization — exactly the clinic's category. medicalSpecialty uses the
// "Physiotherapy" enum member (the valid schema.org value for physical therapy).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'PhysicalTherapy',
  '@id': `${b.url}/#clinic`,
  name: b.name,
  url: b.url,
  // Phone/address/geo are omitted until the real NAP is set (see business.ts flags)
  // so structured data never carries placeholder values.
  ...(b.hasPhone ? { telephone: b.phone } : {}),
  email: b.email,
  image: new URL('/og-default.png', site).href,
  description: t.jsonld.description,
  priceRange: b.priceRange,
  ...(b.hasLocation
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: b.address.street,
          addressLocality: b.address.city,
          addressRegion: b.address.region,
          postalCode: b.address.postalCode,
          addressCountry: b.address.country,
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: b.geo.latitude,
          longitude: b.geo.longitude,
        },
      }
    : {}),
  // Widest first: the state, then the counties, then the cities.
  areaServed: [
    { '@type': 'State', name: b.areaServed.state },
    ...b.areaServed.counties.map((c) => ({ '@type': 'AdministrativeArea', name: `${c} County` })),
    ...b.areaServed.cities.map((c) => ({ '@type': 'City', name: c })),
  ],
  medicalSpecialty: b.medicalSpecialty,
  availableLanguage: ['en-US', 'es-US'],
  openingHoursSpecification: b.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  ...(socialSameAs.length ? { sameAs: socialSameAs } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
