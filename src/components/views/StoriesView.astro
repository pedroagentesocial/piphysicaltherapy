---
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import Testimonials from '../Testimonials.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.stories }]} />

<PageHero
  eyebrow={t.stories.eyebrow}
  title={t.stories.title}
  lead={t.stories.lead}
  accent="field"
  image="team"
  pills={[t.common.directAccess, t.common.sameWeek, t.common.seHablaEspanol]}
/>

<Testimonials items={t.stories.items} disclaimer={t.stories.disclaimer} tone="paper-2" />
<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
