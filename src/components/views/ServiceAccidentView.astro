---
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = t.serviceAccident;
const accidentConditions = conditions.filter((c) => c.pillar === 'accident');
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.accident }]} />

<PageHero
  eyebrow={s.eyebrow}
  title={s.title}
  lead={s.lead}
  accent="ember"
  image="accident"
  pills={['Utah PIP', t.common.directAccess, t.common.seHablaEspanol]}
/>

{/* Logistics first: this visitor's top question is "who pays?" */}
<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
  <div class="reveal max-w-2xl">
    <h2 class="display text-3xl sm:text-4xl">{s.logisticsTitle}</h2>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">{s.introBody}</p>
  </div>
  <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {s.logistics.map((l, i) => (
      <div class="reveal rounded-2xl bg-ember-50 p-6" style={`--reveal-delay:${i * 60}ms`}>
        <div class="font-display text-2xl font-extrabold text-ember-700">{String(i + 1).padStart(2, '0')}</div>
        <h3 class="mt-3 font-bold text-ink">{l.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{l.body}</p>
      </div>
    ))}
  </div>
  <p class="mt-6 max-w-3xl text-xs leading-relaxed text-ink-faint">{s.disclaimer}</p>
</section>

<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
  <h2 class="display reveal max-w-2xl text-3xl sm:text-4xl">{s.stepsTitle}</h2>
  <ol role="list" class="mt-9 grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
    {s.steps.map((step, i) => (
      <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
        <div class="flex items-baseline gap-3">
          <span class="font-display text-4xl font-extrabold text-ember-600">{String(i + 1).padStart(2, '0')}</span>
          <span class="h-px flex-1 bg-ink/12"></span>
        </div>
        <h3 class="mt-4 text-lg font-bold text-ink">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
  <h2 class="display reveal max-w-2xl text-3xl sm:text-4xl">{s.whiplashTitle}</h2>
  <div class="mt-8"><ConditionsGrid items={accidentConditions} /></div>
</section>

<Faq title={s.faqTitle} items={s.faq} />
<CtaBand title={s.ctaTitle} body={t.home.ctaBody} accent="ember" />
