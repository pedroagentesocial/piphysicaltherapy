---
import { render } from 'astro:content';
import Breadcrumbs from '../Breadcrumbs.astro';
import Img from '../Img.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { localeTags, type Lang } from '../../i18n/config';
import { readingMinutes, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  localePaths: Partial<Record<Lang, string>>;
}
const { post, localePaths } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(post);

const { title, description, pubDate, updatedDate, image, sources } = post.data;
const dateFmt = new Intl.DateTimeFormat(localeTags[lang], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const otherLang = (Object.keys(localePaths) as Lang[]).find((l) => l !== lang);
---

<Breadcrumbs
  items={[
    { label: t.nav.home, href: hrefFor('home', lang) },
    { label: t.nav.blog, href: hrefFor('blog', lang) },
    { label: title },
  ]}
/>

<article class="pb-6">
  <header class="mx-auto max-w-3xl px-5 pt-10 sm:px-8 sm:pt-14">
    <p class="eyebrow reveal text-field-700">{t.blog.eyebrow}</p>
    <h1 class="display reveal mt-5 text-[clamp(2.1rem,5vw,3.6rem)]">{title}</h1>
    <p class="reveal mt-5 text-lg leading-relaxed text-ink-soft">{description}</p>
    <p class="reveal mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-faint">
      <span>{t.blog.published} <time datetime={iso(pubDate)}>{dateFmt.format(pubDate)}</time></span>
      {updatedDate && (
        <span>· {t.blog.updated} <time datetime={iso(updatedDate)}>{dateFmt.format(updatedDate)}</time></span>
      )}
      <span>· {t.blog.minRead.replace('{n}', String(readingMinutes(post)))}</span>
      {otherLang && (
        <a href={localePaths[otherLang]} hreflang={localeTags[otherLang]} lang={localeTags[otherLang]} class="link-underline font-semibold text-field-800">
          {t.blog.otherLang}
        </a>
      )}
    </p>
  </header>

  {image && (
    <div class="reveal mx-auto mt-10 max-w-4xl px-5 sm:px-8">
      <div class="overflow-hidden rounded-[1.8rem] shadow-[var(--shadow-soft)]">
        <Img name={image} eager ratio="16/9" sizes="(min-width:960px) 56rem, 95vw" />
      </div>
    </div>
  )}

  <div class="prose-article mx-auto mt-10 max-w-3xl px-5 sm:px-8">
    <Content />
  </div>

  <footer class="mx-auto mt-14 max-w-3xl px-5 sm:px-8">
    <section aria-labelledby="sources-title" class="rounded-3xl bg-paper-2 p-6 sm:p-8">
      <h2 id="sources-title" class="font-display text-xl font-extrabold text-ink">{t.blog.sourcesTitle}</h2>
      <p class="mt-1 text-sm text-ink-faint">{t.blog.sourcesNote}</p>
      <ol class="mt-5 space-y-3 text-sm leading-relaxed text-ink-soft">
        {sources.map((s, i) => (
          <li id={`source-${i + 1}`} class="flex gap-3 scroll-mt-28">
            <span class="w-7 shrink-0 font-bold text-field-800">[{i + 1}]</span>
            <span class="min-w-0">
              {s.publisher}. <a href={s.url} target="_blank" rel="noopener" class="font-semibold text-ink underline decoration-ink/25 underline-offset-2 [overflow-wrap:anywhere] hover:decoration-field-600">{s.title}</a>. {s.date}.
            </span>
          </li>
        ))}
      </ol>
    </section>

    <p class="mt-8 text-xs leading-relaxed text-ink-faint">{t.blog.disclaimer}</p>

    <a href={hrefFor('blog', lang)} class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-field-800">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      {t.blog.back}
    </a>
  </footer>
</article>

<CtaBand title={t.blog.ctaTitle} body={t.blog.ctaBody} />
