---
import Breadcrumbs from '../Breadcrumbs.astro';
import Img from '../Img.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { localeTags } from '../../i18n/config';
import { postHref, readingMinutes, type Post } from '../../lib/blog';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dateFmt = new Intl.DateTimeFormat(localeTags[lang], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.blog }]} />

<header class="mx-auto max-w-6xl px-5 pb-2 pt-10 sm:px-8 sm:pt-14">
  <p class="eyebrow reveal text-field-700">{t.blog.eyebrow}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.3rem,5.5vw,4rem)]">{t.blog.title}</h1>
  <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{t.blog.lead}</p>
</header>

<section class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
  {posts.length === 0 ? (
    <p class="text-ink-soft">{t.blog.empty}</p>
  ) : (
    <ul role="list" class="grid gap-6 sm:grid-cols-2">
      {posts.map((post, i) => (
        <li class="reveal" style={`--reveal-delay:${(i % 2) * 70}ms`}>
          <a
            href={postHref(post)}
            class="group flex h-full flex-col overflow-hidden rounded-3xl border border-ink/10 bg-paper transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-lift)]"
          >
            {post.data.image && (
              <div class="overflow-hidden">
                <Img name={post.data.image} ratio="16/9" sizes="(min-width:640px) 45vw, 90vw" class="transition-transform duration-500 group-hover:scale-[1.03]" />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-xs font-semibold text-ink-faint">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{dateFmt.format(post.data.pubDate)}</time>
                <span aria-hidden="true"> · </span>
                {t.blog.minRead.replace('{n}', String(readingMinutes(post)))}
              </p>
              <h2 class="mt-3 font-display text-xl font-extrabold leading-tight text-ink sm:text-2xl">{post.data.title}</h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{post.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-field-800">
                {t.blog.readMore}
                <svg class="transition-transform duration-200 group-hover:translate-x-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

<CtaBand title={t.blog.ctaTitle} body={t.blog.ctaBody} />
