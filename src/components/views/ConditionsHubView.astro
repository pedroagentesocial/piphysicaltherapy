---
import Breadcrumbs from '../Breadcrumbs.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.conditionsHub;
const rehab = conditions.filter((c) => c.pillar === 'rehab');
const accident = conditions.filter((c) => c.pillar === 'accident');
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.conditions }]} />

<header class="mx-auto max-w-6xl px-5 pb-6 pt-10 sm:px-8 sm:pt-14">
  <p class="eyebrow reveal text-field-700">{h.eyebrow}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.3rem,5.5vw,4rem)]">{h.title}</h1>
  <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{h.lead}</p>
</header>

<section class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
  <h2 class="reveal text-xs font-bold uppercase tracking-widest text-field-700">{h.rehabGroup}</h2>
  <div class="mt-5"><ConditionsGrid items={rehab} /></div>
</section>

<section class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
  <h2 class="reveal text-xs font-bold uppercase tracking-widest text-ember-700">{h.accidentGroup}</h2>
  <div class="mt-5"><ConditionsGrid items={accident} /></div>
</section>

<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
