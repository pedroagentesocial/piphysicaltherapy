---
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.conditionsHub;
const rehab = conditions.filter((c) => c.pillar === 'rehab');
const accident = conditions.filter((c) => c.pillar === 'accident');
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.conditions }]} />

<PageHero
  eyebrow={h.eyebrow}
  title={h.title}
  lead={h.lead}
  accent="field"
  image="clinic"
  pills={[t.common.directAccess, t.common.sameWeek, t.common.seHablaEspanol]}
/>

{/* Rehab group */}
<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
  <div class="reveal flex items-center gap-3">
    <span class="h-2.5 w-2.5 rounded-full bg-field-500" aria-hidden="true"></span>
    <h2 class="text-sm font-bold uppercase tracking-widest text-field-700">{h.rehabGroup}</h2>
  </div>
  <div class="mt-6"><ConditionsGrid items={rehab} /></div>
</section>

{/* Accident group */}
<section class="border-y border-ink/10 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="reveal flex items-center gap-3">
      <span class="h-2.5 w-2.5 rounded-full bg-ember-500" aria-hidden="true"></span>
      <h2 class="text-sm font-bold uppercase tracking-widest text-ember-700">{h.accidentGroup}</h2>
    </div>
    <div class="mt-6"><ConditionsGrid items={accident} /></div>
  </div>
</section>

<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
