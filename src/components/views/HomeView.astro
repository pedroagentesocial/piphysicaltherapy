---
import Hero from '../home/Hero.astro';
import PillarSplit from '../home/PillarSplit.astro';
import TrustGrid from '../home/TrustGrid.astro';
import ProcessSteps from '../ProcessSteps.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import Testimonials from '../Testimonials.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { conditions } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Hero />
<TrustGrid />
<PillarSplit />

<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
  <div class="reveal max-w-2xl">
    <h2 class="display text-3xl sm:text-[2.6rem]">{t.home.conditionsTitle}</h2>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.home.conditionsLead}</p>
  </div>
  <div class="mt-9">
    <ConditionsGrid items={conditions} />
  </div>
</section>

<ProcessSteps title={t.home.processTitle} />
<Testimonials title={t.home.storiesTitle} items={t.stories.items} />
<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
