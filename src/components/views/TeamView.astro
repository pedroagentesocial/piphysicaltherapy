---
import Breadcrumbs from '../Breadcrumbs.astro';
import Img from '../Img.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { team } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.team }]} />

<header class="mx-auto max-w-6xl px-5 pb-6 pt-10 sm:px-8 sm:pt-14">
  <p class="eyebrow reveal text-field-700">{t.team.eyebrow}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.3rem,5.5vw,4rem)]">{t.team.title}</h1>
  <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{t.team.lead}</p>
</header>

<section class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
  <div class="grid gap-7 md:grid-cols-3">
    {team.map((m, i) => {
      const member = t.team.members[m.id as keyof typeof t.team.members];
      return (
        <article class="reveal flex flex-col overflow-hidden rounded-3xl border border-ink/10 bg-paper" style={`--reveal-delay:${i * 80}ms`}>
          <Img name={m.image} ratio="4/5" sizes="(min-width:768px) 30vw, 92vw" />
          <div class="flex flex-1 flex-col p-6">
            <h2 class="font-display text-xl font-extrabold text-ink">{m.name}</h2>
            <p class="mt-1 text-sm font-bold text-field-700">{m.credentials} · {member.role}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{member.bio}</p>
          </div>
        </article>
      );
    })}
  </div>

  <div class="reveal mt-12 rounded-3xl bg-paper-2 p-7 sm:p-9">
    <h2 class="font-display text-2xl font-extrabold text-ink">{t.team.credentialsTitle}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{t.team.credentialsBody}</p>
  </div>

  <p class="mt-5 text-xs leading-relaxed text-ink-faint">{t.team.note}</p>
</section>

<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
