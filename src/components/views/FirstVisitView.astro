---
import Breadcrumbs from '../Breadcrumbs.astro';
import ProcessSteps from '../ProcessSteps.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const v = t.firstVisit;
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.firstVisit }]} />

<header class="mx-auto max-w-3xl px-5 pb-4 pt-10 sm:px-8 sm:pt-14">
  <p class="eyebrow reveal text-field-700">{v.eyebrow}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.3rem,5.5vw,4rem)]">{v.title}</h1>
  <p class="reveal mt-5 text-lg leading-relaxed text-ink-soft">{v.lead}</p>
</header>

<ProcessSteps title={v.expectTitle} />

<section class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:px-8 lg:grid-cols-2">
  <div class="reveal rounded-3xl bg-paper-2 p-7 sm:p-9">
    <h2 class="font-display text-2xl font-extrabold text-ink">{v.bringTitle}</h2>
    <ul role="list" class="mt-5 space-y-3">
      {v.bring.map((b) => (
        <li class="flex gap-3 text-ink-soft">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-0.5 shrink-0 text-field-700" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          <span class="leading-relaxed">{b}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="reveal rounded-3xl bg-field-700 p-7 text-paper sm:p-9" style="--reveal-delay:80ms">
    <h2 class="font-display text-2xl font-extrabold">{v.directAccessTitle}</h2>
    <p class="mt-4 leading-relaxed text-paper/85">{v.directAccessBody}</p>
  </div>
</section>

<Faq title={v.faqTitle} items={v.faq} />
<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
