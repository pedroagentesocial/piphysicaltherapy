---
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import ProcessSteps from '../ProcessSteps.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const v = t.firstVisit;
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.firstVisit }]} />

<PageHero
  eyebrow={v.eyebrow}
  title={v.title}
  lead={v.lead}
  accent="field"
  image="process"
  pills={[t.common.directAccess, t.common.sameWeek, t.common.seHablaEspanol]}
/>

<ProcessSteps title={v.expectTitle} eyebrow={t.home.processEyebrow} />

{/* Bring + prepare */}
<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
  <div class="grid gap-6 lg:grid-cols-2">
    <div class="reveal rounded-3xl border border-ink/10 bg-paper p-7 sm:p-9">
      <div class="flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-field-50 text-field-700" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6a1 1 0 0 1 1 1v1h2.5A1.5 1.5 0 0 1 20 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6.5A1.5 1.5 0 0 1 5.5 5H8V4a1 1 0 0 1 1-1z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2 class="font-display text-2xl font-extrabold text-ink">{v.bringTitle}</h2>
      </div>
      <ul role="list" class="mt-6 space-y-3">
        {v.bring.map((b) => (
          <li class="flex gap-3 text-ink-soft">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-0.5 shrink-0 text-field-600" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="leading-relaxed">{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal rounded-3xl border border-ink/10 bg-paper p-7 sm:p-9" style="--reveal-delay:80ms">
      <div class="flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-field-50 text-field-700" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="8.5"/></svg>
        </span>
        <h2 class="font-display text-2xl font-extrabold text-ink">{v.prepareTitle}</h2>
      </div>
      <ol role="list" class="mt-6 space-y-4">
        {v.prepare.map((p, i) => (
          <li class="flex gap-3.5">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-field-700 text-xs font-extrabold text-paper">{i + 1}</span>
            <span class="leading-relaxed text-ink-soft">{p}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* Referral + payment band */}
<section class="mx-auto max-w-6xl px-5 pb-4 sm:px-8">
  <div class="surface-ink reveal relative overflow-hidden rounded-[2rem] px-7 py-10 sm:px-12 sm:py-12">
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-field-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <h2 class="font-display text-2xl font-extrabold">{v.directAccessTitle}</h2>
        <p class="mt-3 leading-relaxed text-paper/85">{v.directAccessBody}</p>
      </div>
      <div class="md:border-l md:border-paper/15 md:pl-12">
        <h2 class="font-display text-2xl font-extrabold">{v.paymentTitle}</h2>
        <p class="mt-3 leading-relaxed text-paper/85">{v.paymentBody}</p>
      </div>
    </div>
  </div>
</section>

{/* What happens after */}
<section class="mt-12 border-y border-ink/10 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="reveal">
        <p class="eyebrow text-field-700">{v.eyebrow}</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">{v.afterTitle}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{v.afterBody}</p>
      </div>
      <ul role="list" class="reveal grid gap-3 sm:grid-cols-2" style="--reveal-delay:80ms">
        {v.afterPoints.map((p) => (
          <li class="flex items-start gap-3 rounded-2xl border border-ink/10 bg-paper p-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-0.5 shrink-0 text-field-600" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="text-sm leading-relaxed text-ink">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<Faq title={v.faqTitle} items={v.faq} />
<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent="field" />
