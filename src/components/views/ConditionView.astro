---
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

interface Props {
  /** Condition id from data/content.ts (e.g. 'back', 'whiplash'). */
  id: string;
}
const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const def = conditions.find((c) => c.id === id)!;
const c = t.conditions[id as keyof typeof t.conditions];
const isEmber = def.pillar === 'accident';
const serviceRoute = isEmber ? 'servicesAccident' : 'servicesPT';
const serviceLabel = isEmber ? t.nav.accident : t.nav.rehab;
const accentText = isEmber ? 'text-ember-700' : 'text-field-700';
const dot = isEmber ? 'bg-ember-500' : 'bg-field-500';
---

<Breadcrumbs
  items={[
    { label: t.nav.home, href: hrefFor('home', lang) },
    { label: t.nav.conditions, href: hrefFor('conditions', lang) },
    { label: c.name },
  ]}
/>

<article class="mx-auto max-w-3xl px-5 pb-8 pt-10 sm:px-8 sm:pt-14">
  <p class={`eyebrow reveal ${accentText}`}>{t.nav.conditions}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.2rem,5vw,3.6rem)]">{c.name}</h1>
  <p class="reveal mt-5 text-lg leading-relaxed text-ink-soft">{c.lead}</p>

  <div class="mt-12 grid gap-10 sm:grid-cols-2">
    <section class="reveal">
      <h2 class="font-display text-xl font-extrabold text-ink">{c.symptomsTitle}</h2>
      <ul role="list" class="mt-4 space-y-3">
        {c.symptoms.map((sym) => (
          <li class="flex gap-3 text-ink-soft">
            <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${dot}`} aria-hidden="true"></span>
            <span class="leading-relaxed">{sym}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="reveal" style="--reveal-delay:80ms">
      <h2 class="font-display text-xl font-extrabold text-ink">{c.approachTitle}</h2>
      <ul role="list" class="mt-4 space-y-3">
        {c.approach.map((step) => (
          <li class="flex gap-3 text-ink-soft">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class={`mt-0.5 shrink-0 ${accentText}`} aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            <span class="leading-relaxed">{step}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <a href={hrefFor(serviceRoute, lang)} class={`mt-12 inline-flex items-center gap-2 font-bold ${accentText}`}>
    {t.common.learnMore}: {serviceLabel}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a>
</article>

<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent={isEmber ? 'ember' : 'field'} />
