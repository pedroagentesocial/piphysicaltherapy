---
import Breadcrumbs from '../Breadcrumbs.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

interface Props {
  /** Condition id from data/content.ts (e.g. 'back', 'whiplash'). */
  id: string;
}
const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const def = conditions.find((c) => c.id === id)!;
const c = t.conditions[id as keyof typeof t.conditions];
const isEmber = def.pillar === 'accident';
const serviceRoute = isEmber ? 'servicesAccident' : 'servicesPT';
const serviceLabel = isEmber ? t.nav.accident : t.nav.rehab;
const accentText = isEmber ? 'text-ember-700' : 'text-field-700';
const accentChip = isEmber ? 'bg-ember-50 text-ember-700' : 'bg-field-50 text-field-700';
const dot = isEmber ? 'bg-ember-500' : 'bg-field-500';

// Other conditions for internal linking.
const related = conditions.filter((x) => x.id !== id);
---

<Breadcrumbs
  items={[
    { label: t.nav.home, href: hrefFor('home', lang) },
    { label: t.nav.conditions, href: hrefFor('conditions', lang) },
    { label: c.name },
  ]}
/>

<header class="mx-auto max-w-6xl px-5 pb-8 pt-10 sm:px-8 sm:pt-14">
  <p class={`eyebrow reveal ${accentText}`}>{t.nav.conditions}</p>
  <h1 class="display reveal mt-5 text-[clamp(2.2rem,5vw,3.8rem)]">{c.name}</h1>
  <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{c.lead}</p>
</header>

<section class="mx-auto max-w-6xl px-5 pb-4 sm:px-8">
  <div class="grid gap-6 md:grid-cols-2">
    <div class="reveal rounded-3xl border border-ink/10 bg-paper p-7 sm:p-8">
      <div class="flex items-center gap-3">
        <span class={`grid h-11 w-11 place-items-center rounded-xl ${accentChip}`} aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l2.2-6 3.6 12 2.2-6H21" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2 class="font-display text-xl font-extrabold text-ink">{c.symptomsTitle}</h2>
      </div>
      <ul role="list" class="mt-6 space-y-3">
        {c.symptoms.map((sym) => (
          <li class="flex gap-3 text-ink-soft">
            <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${dot}`} aria-hidden="true"></span>
            <span class="leading-relaxed">{sym}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal rounded-3xl border border-ink/10 bg-paper p-7 sm:p-8" style="--reveal-delay:80ms">
      <div class="flex items-center gap-3">
        <span class={`grid h-11 w-11 place-items-center rounded-xl ${accentChip}`} aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2 class="font-display text-xl font-extrabold text-ink">{c.approachTitle}</h2>
      </div>
      <ul role="list" class="mt-6 space-y-3">
        {c.approach.map((step) => (
          <li class="flex gap-3 text-ink-soft">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class={`mt-0.5 shrink-0 ${accentText}`} aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="leading-relaxed">{step}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* Service link */}
  <a
    href={hrefFor(serviceRoute, lang)}
    class="reveal group mt-6 flex items-center justify-between gap-4 rounded-3xl border border-ink/10 bg-paper p-6 transition-all hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-[var(--shadow-soft)] sm:p-7"
  >
    <span class="flex items-center gap-4">
      <span class={`hidden h-2 w-12 rounded-full sm:block ${dot}`} aria-hidden="true"></span>
      <span class={`font-display text-lg font-extrabold ${accentText}`}>{t.common.learnMore}: {serviceLabel}</span>
    </span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class={`shrink-0 transition-transform group-hover:translate-x-1 ${accentText}`} aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a>
</section>

{/* Related conditions */}
<section class="mt-12 border-y border-ink/10 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <h2 class="display reveal text-2xl sm:text-3xl">{t.conditionsHub.title}</h2>
    <div class="mt-7"><ConditionsGrid items={related} /></div>
  </div>
</section>

<CtaBand title={t.home.ctaTitle} body={t.home.ctaBody} accent={isEmber ? 'ember' : 'field'} />
