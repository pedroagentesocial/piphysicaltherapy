---
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import ConditionsGrid from '../ConditionsGrid.astro';
import ProcessSteps from '../ProcessSteps.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { conditions } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = t.servicePT;
const rehabConditions = conditions.filter((c) => c.pillar === 'rehab');

// Specialized programs — anchors match the nav dropdown + home Services links.
const programs = [
  { id: 'sports-rehab', data: s.extra.sports, accent: 'field' as const },
  { id: 'vestibular-balance', data: s.extra.vestibular, accent: 'field' as const },
  { id: 'work-injury', data: s.extra.work, accent: 'ember' as const },
];
---

<Breadcrumbs items={[{ label: t.nav.home, href: hrefFor('home', lang) }, { label: t.nav.rehab }]} />

<PageHero
  eyebrow={s.eyebrow}
  title={s.title}
  lead={s.lead}
  accent="field"
  image="rehab"
  pills={[t.common.directAccess, t.common.sameWeek, t.common.seHablaEspanol]}
/>

<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div class="reveal lg:sticky lg:top-24">
      <h2 class="display text-3xl sm:text-4xl">{s.introTitle}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{s.introBody}</p>
    </div>
    <dl class="grid gap-px overflow-hidden rounded-3xl border border-ink/10 bg-ink/10 sm:grid-cols-2">
      {s.benefits.map((b, i) => (
        <div class="reveal bg-paper p-6" style={`--reveal-delay:${i * 60}ms`}>
          <dt class="font-display text-lg font-extrabold text-ink">{b.title}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-soft">{b.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
  <h2 class="display reveal max-w-2xl text-3xl sm:text-4xl">{s.treatTitle}</h2>
  <div class="mt-8"><ConditionsGrid items={rehabConditions} /></div>
</section>

{/* Specialized programs — deep-linked from the nav and home Services section. */}
<section class="bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="reveal max-w-2xl">
      <p class="eyebrow text-field-700">{s.extraEyebrow}</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl">{s.extraTitle}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{s.extraLead}</p>
    </div>

    <div class="mt-10 grid gap-5">
      {programs.map((p, i) => (
        <article
          id={p.id}
          class="reveal scroll-mt-28 overflow-hidden rounded-[1.8rem] border border-ink/10 bg-paper p-7 sm:p-9"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:gap-12">
            <div class="lg:w-2/5">
              <span
                class:list={[
                  'inline-block rounded-full px-3 py-1 text-xs font-bold text-paper',
                  p.accent === 'ember' ? 'bg-ember-600' : 'bg-field-700',
                ]}
              >
                {s.extraEyebrow}
              </span>
              <h3 class="display mt-4 text-2xl sm:text-[1.75rem]">{p.data.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{p.data.body}</p>
            </div>
            <ul role="list" class="grid flex-1 gap-3 sm:grid-cols-2 lg:pt-1">
              {p.data.points.map((pt) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink">
                  <svg
                    width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                    class:list={['mt-0.5 shrink-0', p.accent === 'ember' ? 'text-ember-600' : 'text-field-600']}
                    aria-hidden="true"
                  ><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<ProcessSteps title={t.home.processTitle} />
<Faq title={s.faqTitle} items={s.faq} />
<CtaBand title={s.ctaTitle} body={t.home.ctaBody} accent="field" />
