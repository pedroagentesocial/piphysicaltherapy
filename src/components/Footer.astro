---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor, type RouteKey } from '../i18n/routes';
import { business } from '../data/business';
import { localeTags } from '../i18n/config';
import SocialLinks from './SocialLinks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Service area, widest first: the whole state, then counties, then cities.
// Intl handles the locale's list grammar ("… and …" / "… y …").
const listFmt = new Intl.ListFormat(localeTags[lang], { style: 'long', type: 'conjunction' });
const napCounties = t.footer.napCounties.replace('{list}', listFmt.format(business.areaServed.counties));
const napCities = t.footer.napCities.replace('{list}', listFmt.format(business.areaServed.cities));

// The three promises worth repeating at the bottom of every page.
const promises = [t.common.directAccess, t.common.sameWeek, t.common.seHablaEspanol];

const services: { key: RouteKey; label: string }[] = [
  { key: 'servicesPT', label: t.nav.rehab },
  { key: 'servicesAccident', label: t.nav.accident },
  { key: 'conditions', label: t.nav.conditions },
];
const clinic: { key: RouteKey; label: string }[] = [
  { key: 'firstVisit', label: t.nav.firstVisit },
  { key: 'team', label: t.nav.team },
  { key: 'stories', label: t.nav.stories },
  { key: 'contact', label: t.nav.contact },
];
const legal: { key: RouteKey; label: string }[] = [
  { key: 'privacy', label: t.footer.privacy },
  { key: 'terms', label: t.footer.terms },
];
---

<footer class="mt-24 bg-paper-2">
  {/* Brand hairline: navy → teal → aqua, the palette in one stroke. */}
  <div class="h-1 w-full bg-gradient-to-r from-ember-700 via-field-600 to-aqua" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    {/* The three promises, repeated where people decide to call. */}
    <ul role="list" class="flex flex-wrap gap-2.5 border-b border-ink/10 pb-9">
      {promises.map((p) => (
        <li class="pill bg-paper">
          <span class="size-1.5 rounded-full bg-field-500" aria-hidden="true"></span>
          {p}
        </li>
      ))}
    </ul>

    {/* At sm the brand block spans both columns and the two navs sit side by
        side under it; splitting them 1 + 1 left a ragged hole. */}
    <div class="grid gap-10 pt-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr] lg:gap-14">
      <div class="sm:col-span-2 lg:col-span-1">
        <img src="/logo-lockup.png" alt={t.site.name} width="687" height="220" class="h-16 w-auto sm:h-20" />
        <p class="mt-4 max-w-xs leading-relaxed text-ink-soft">{t.site.tagline}</p>

        <address class="mt-6 space-y-3 text-sm not-italic leading-relaxed text-ink-soft">
          {business.hasLocation ? (
            <p class="flex items-start gap-2.5">
              <svg class="mt-0.5 size-4 shrink-0 text-field-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>
                {business.address.street}<br />
                {business.address.city}, {business.address.region} {business.address.postalCode}
              </span>
            </p>
          ) : (
            /* No clinic address to publish yet. A quiet "opening soon" badge
               reads as a plan; the bare words "Coming soon" read as a bug. */
            <p class="inline-flex max-w-full items-center gap-2 rounded-full border border-dashed border-field-300 bg-paper px-3.5 py-1.5 font-semibold text-field-800">
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {t.common.locationSoon}
            </p>
          )}

          <div class="space-y-1">
            {business.hasPhone && (
              <a href={`tel:${business.phone}`} class="link-underline block font-bold text-ink">{business.phoneDisplay}</a>
            )}
            <a href={`mailto:${business.email}`} class="link-underline block">{business.email}</a>
          </div>
        </address>

        <h2 class="eyebrow mt-7 text-ink-faint">{t.common.followUs}</h2>
        <SocialLinks class="mt-4" />
      </div>

      <nav aria-label={t.footer.servicesTitle}>
        <h2 class="eyebrow text-ink-faint">{t.footer.servicesTitle}</h2>
        <ul role="list" class="mt-5 space-y-3">
          {services.map((l) => (
            <li>
              <a href={hrefFor(l.key, lang)} class="inline-block text-sm text-ink-soft transition-all duration-200 hover:translate-x-0.5 hover:text-field-800">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.clinicTitle}>
        <h2 class="eyebrow text-ink-faint">{t.footer.clinicTitle}</h2>
        <ul role="list" class="mt-5 space-y-3">
          {clinic.map((l) => (
            <li>
              <a href={hrefFor(l.key, lang)} class="inline-block text-sm text-ink-soft transition-all duration-200 hover:translate-x-0.5 hover:text-field-800">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="mt-14 max-w-3xl text-xs leading-relaxed text-ink-faint">
      <span class="font-semibold text-ink-soft">{t.footer.napState}</span> {napCounties} {napCities}
    </p>

    <div class="mt-8 flex flex-col gap-4 border-t border-ink/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-faint">
        &copy; <span data-year>2026</span> {business.name}. {t.footer.rights}
      </p>
      <nav aria-label={t.footer.legalTitle}>
        <ul role="list" class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {legal.map((l) => (
            <li>
              <a href={hrefFor(l.key, lang)} class="text-xs text-ink-faint transition-colors hover:text-field-800">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-year]');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
