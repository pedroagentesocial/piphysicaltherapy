---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor, type RouteKey } from '../i18n/routes';
import { business } from '../data/business';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services: { key: RouteKey; label: string }[] = [
  { key: 'servicesPT', label: t.nav.rehab },
  { key: 'servicesAccident', label: t.nav.accident },
  { key: 'conditions', label: t.nav.conditions },
];
const clinic: { key: RouteKey; label: string }[] = [
  { key: 'team', label: t.nav.team },
  { key: 'firstVisit', label: t.nav.firstVisit },
  { key: 'stories', label: t.nav.stories },
  { key: 'contact', label: t.nav.contact },
];
const legal: { key: RouteKey; label: string }[] = [
  { key: 'privacy', label: t.footer.privacy },
  { key: 'terms', label: t.footer.terms },
];
---

<footer class="mt-24 border-t border-ink/10 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2 text-ink">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-field-700 font-display text-sm font-extrabold text-paper">PI</span>
          <span class="font-display text-lg font-extrabold tracking-tight">{t.site.name}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">{t.site.tagline}</p>
        <address class="mt-5 text-sm not-italic leading-relaxed text-ink-soft">
          {business.address.street}<br />
          {business.address.city}, {business.address.region} {business.address.postalCode}<br />
          <a href={`tel:${business.phone}`} class="link-underline font-bold text-ink">{business.phoneDisplay}</a>
        </address>
      </div>

      <nav aria-label={t.footer.servicesTitle}>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-faint">{t.footer.servicesTitle}</h2>
        <ul role="list" class="mt-4 space-y-2.5">
          {services.map((l) => (
            <li><a href={hrefFor(l.key, lang)} class="text-sm text-ink-soft transition-colors hover:text-ink">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.clinicTitle}>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-faint">{t.footer.clinicTitle}</h2>
        <ul role="list" class="mt-4 space-y-2.5">
          {clinic.map((l) => (
            <li><a href={hrefFor(l.key, lang)} class="text-sm text-ink-soft transition-colors hover:text-ink">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legalTitle}>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-faint">{t.footer.legalTitle}</h2>
        <ul role="list" class="mt-4 space-y-2.5">
          {legal.map((l) => (
            <li><a href={hrefFor(l.key, lang)} class="text-sm text-ink-soft transition-colors hover:text-ink">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="mt-12 max-w-3xl text-xs leading-relaxed text-ink-faint">{t.footer.nap}</p>
    <p class="mt-3 max-w-3xl text-xs leading-relaxed text-ink-faint">{t.footer.disclaimer}</p>
    <p class="mt-6 text-xs text-ink-faint">
      &copy; <span data-year>2026</span> {business.name}. {t.footer.rights}
    </p>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-year]');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
