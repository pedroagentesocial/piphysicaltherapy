---
import { blogImages, images, isBlogImage, type PostImageKey } from '../data/images';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  /** Key into the image manifest (site images or blog-only photos). */
  name: PostImageKey;
  /** Above-the-fold images set eager (hero); everything else lazy-loads. */
  eager?: boolean;
  /** `sizes` attribute for responsive selection. */
  sizes?: string;
  /** Intrinsic ratio to reserve space and avoid layout shift, e.g. '4/5'. */
  ratio?: string;
  class?: string;
}

const { name, eager = false, sizes = '100vw', ratio = '4/3', class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const img = isBlogImage(name) ? blogImages[name] : images[name];

let src: string;
let srcset: string;
if (isBlogImage(name)) {
  // Local blog photo: a 1600px original plus an 800px rendition next to it.
  src = blogImages[name].src;
  srcset = `${src.replace(/\.jpg$/, '-800.jpg')} 800w, ${src} 1600w`;
} else {
  const base = `https://images.unsplash.com/photo-${images[name].id}?auto=format&fit=crop&q=80`;
  const widths = [640, 960, 1280, 1600, 2000];
  srcset = widths.map((w) => `${base}&w=${w} ${w}w`).join(', ');
  src = `${base}&w=1280`;
}
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={img.alt[lang]}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={`block h-full w-full object-cover ${className}`}
  style={`aspect-ratio:${ratio};background-color:var(--color-paper-3)`}
  onerror="this.style.background='linear-gradient(135deg,var(--color-field-200),var(--color-ember-200))';this.removeAttribute('src');this.removeAttribute('srcset');"
/>
