---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor } from '../i18n/routes';
import { business } from '../data/business';
import type { Accent } from '../data/content';

interface Props {
  title: string;
  body: string;
  accent?: Accent;
}
const { title, body, accent = 'field' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const btn = accent === 'ember' ? 'btn-ember' : 'btn-field';
---

<section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
  <div class="surface-ink relative overflow-hidden rounded-[2rem] px-7 py-12 sm:px-12 sm:py-16">
    <div class={`pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full blur-3xl ${accent === 'ember' ? 'bg-ember-500/25' : 'bg-field-500/25'}`}></div>
    <div class="relative max-w-2xl">
      <h2 class="display text-3xl sm:text-[2.6rem]">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-paper/80">{body}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={hrefFor('contact', lang)} class={`btn ${btn}`}>{t.nav.book}</a>
        <a href={`tel:${business.phone}`} class="btn btn-on-ink">{t.nav.call} {business.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>
