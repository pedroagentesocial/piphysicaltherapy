---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { business } from '../../data/business';
import { images } from '../../data/images';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.home.hero;
const slides = h.slides;

// Poster still (shown before the video loads, or if /hero.mp4 is missing).
const poster = `https://images.unsplash.com/photo-${images.heroHome.id}?auto=format&fit=crop&q=80&w=1800`;
---

<section
  id="hero"
  data-hero-carousel
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden text-paper"
  aria-roledescription="carousel"
  aria-label={slides[0].eyebrow}
>
  {/* One background video per slide (public/videos/hero-1..3.mp4). */}
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    {slides.map((_, i) => (
      <video
        class:list={['hero-video', i === 0 && 'is-active']}
        data-hero-video={i}
        muted
        loop
        playsinline
        autoplay={i === 0}
        preload={i === 0 ? 'auto' : 'none'}
        poster={i === 0 ? poster : undefined}
      >
        <source src={`/videos/hero-${i + 1}.mp4`} type="video/mp4" />
      </video>
    ))}
  </div>

  {/* Legibility overlay: brand navy, weighted to the left where the text sits. */}
  <div
    class="absolute inset-0 -z-10"
    style="background:
      linear-gradient(180deg, oklch(0.2 0.05 252 / 0.45) 0%, oklch(0.2 0.05 252 / 0.30) 45%, oklch(0.18 0.05 252 / 0.72) 100%),
      linear-gradient(90deg, oklch(0.18 0.05 252 / 0.62) 0%, oklch(0.18 0.05 252 / 0.18) 60%, transparent 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-6xl px-5 pb-24 pt-[calc(var(--header-h)+2rem)] sm:px-8">
    {/* Slides — grid-stacked so the box keeps the tallest slide's height. */}
    <div class="hero-copy">
      {slides.map((s, i) => (
        <div
          class:list={['hero-slide', i === 0 && 'is-active']}
          data-slide={i}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${slides.length}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <p class="eyebrow text-aqua">{s.eyebrow}</p>
          <h1 class="display mt-4 max-w-3xl text-[clamp(2.15rem,6.4vw,5.4rem)] text-paper sm:mt-5">
            {s.title}
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-paper/85 sm:mt-6 sm:text-xl">
            {s.subtitle}
          </p>
        </div>
      ))}
    </div>

    {/* Actions + trust bullets stay fixed beneath the rotating copy. */}
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={hrefFor('contact', lang)} class="btn btn-on-ink text-base">{h.primary}</a>
      <a
        href={business.hasPhone ? `tel:${business.phone}` : hrefFor('contact', lang)}
        class="btn text-base border-[1.5px] border-paper/55 text-paper hover:bg-paper/12 hover:border-paper"
      >
        {business.hasPhone ? `${t.nav.call} ${business.phoneDisplay}` : t.nav.write}
      </a>
    </div>
    <ul role="list" class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-paper/85">
      <li class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>{t.common.directAccess}</li>
      <li class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>{t.common.sameWeek}</li>
      <li class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-field-400"></span>{t.common.seHablaEspanol}</li>
    </ul>
  </div>

  {/* Prev / next arrows */}
  <button
    type="button"
    data-hero-prev
    class="hero-arrow left-3 hidden sm:left-5 sm:grid"
    aria-label="Previous slide"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button
    type="button"
    data-hero-next
    class="hero-arrow right-3 hidden sm:right-5 sm:grid"
    aria-label="Next slide"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  {/* Dots */}
  <div class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 items-center gap-0.5 sm:bottom-7" role="tablist" aria-label="Slides">
    {slides.map((_, i) => (
      <button
        type="button"
        data-hero-dot={i}
        class:list={['hero-dot', i === 0 && 'is-active']}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>
</section>

<script>
  function initHero() {
    const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
    if (!root || root.dataset.heroReady === 'true') return;
    root.dataset.heroReady = 'true';

    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-hero-video]'));
    if (slides.length <= 1) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DELAY = 6500;
    let index = 0;
    let timer: number | undefined;

    const render = () => {
      slides.forEach((s, i) => {
        const active = i === index;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((d, i) => {
        const active = i === index;
        d.classList.toggle('is-active', active);
        d.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      // Crossfade the matching video; only the active one plays.
      videos.forEach((v, i) => {
        if (i === index) {
          v.classList.add('is-active');
          const p = v.play();
          if (p) p.catch(() => {});
        } else {
          v.classList.remove('is-active');
          v.pause();
        }
      });
      // Warm up the next clip so its crossfade is smooth.
      const next = videos[(index + 1) % videos.length];
      if (next && next.preload === 'none') { next.preload = 'auto'; next.load(); }
    };

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      render();
    };

    const stop = () => { if (timer) { window.clearInterval(timer); timer = undefined; } };
    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => go(index + 1), DELAY);
    };
    // Reset the auto-advance clock after any manual interaction.
    const nudge = (i: number) => { go(i); start(); };

    root.querySelector('[data-hero-next]')?.addEventListener('click', () => nudge(index + 1));
    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => nudge(index - 1));
    dots.forEach((d, i) => d.addEventListener('click', () => nudge(i)));

    // Pause while hovered or when the tab is hidden.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Touch swipe (mobile — arrows are hidden there).
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) nudge(dx < 0 ? index + 1 : index - 1);
    }, { passive: true });

    render();
    start();
  }

  document.addEventListener('astro:page-load', initHero);
</script>
