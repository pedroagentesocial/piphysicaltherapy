---
import Img from '../Img.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { hrefFor } from '../../i18n/routes';
import { pillars } from '../../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
  <div class="reveal max-w-2xl">
    <h2 class="display text-3xl sm:text-[2.8rem]">{t.home.pillarsTitle}</h2>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.home.pillarsLead}</p>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {pillars.map((p, i) => {
      const c = t.home.pillars[p.id];
      const isEmber = p.accent === 'ember';
      return (
        <article
          class="reveal group relative flex flex-col overflow-hidden rounded-[1.8rem] border border-ink/10 bg-paper"
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div class="relative h-52 overflow-hidden sm:h-60">
            <Img name={p.image} ratio="16/9" sizes="(min-width:1024px) 46vw, 92vw" class="transition-transform duration-700 group-hover:scale-105" />
            <span class={`absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-bold text-paper ${isEmber ? 'bg-ember-600' : 'bg-field-700'}`}>{c.label}</span>
          </div>
          <div class="flex flex-1 flex-col p-7">
            <h3 class="font-display text-2xl font-extrabold text-ink">{c.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{c.body}</p>
            <a
              href={hrefFor(p.route, lang)}
              class={`mt-5 inline-flex items-center gap-2 font-bold ${isEmber ? 'text-ember-700' : 'text-field-800'}`}
            >
              {c.cta}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
          <span class={`absolute inset-x-0 bottom-0 h-1 ${isEmber ? 'bg-ember-500' : 'bg-field-500'}`} aria-hidden="true"></span>
        </article>
      );
    })}
  </div>
</section>
