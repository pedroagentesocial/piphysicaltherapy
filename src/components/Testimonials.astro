---
interface Props {
  title: string;
  items: { quote: string; name: string; context: string }[];
  disclaimer?: string;
}
const { title, items, disclaimer } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
  <h2 class="display reveal max-w-2xl text-3xl sm:text-4xl">{title}</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {items.map((it, i) => (
      <figure class="reveal flex flex-col rounded-3xl bg-paper-2 p-7" style={`--reveal-delay:${i * 80}ms`}>
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" class="text-field-500" aria-hidden="true">
          <path d="M9.5 5C6 6.5 4 9.5 4 13v6h7v-7H7.5c0-2 1-3.5 3-4.5L9.5 5Zm9 0C15 6.5 13 9.5 13 13v6h7v-7h-3.5c0-2 1-3.5 3-4.5L18.5 5Z" />
        </svg>
        <blockquote class="mt-4 flex-1 text-[1.05rem] leading-relaxed text-ink">{it.quote}</blockquote>
        <figcaption class="mt-5 border-t border-ink/10 pt-4">
          <p class="font-bold text-ink">{it.name}</p>
          <p class="text-sm text-ink-faint">{it.context}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  {disclaimer && <p class="mt-6 max-w-2xl text-xs leading-relaxed text-ink-faint">{disclaimer}</p>}
</section>
