---
import LanguageSelector from './LanguageSelector.astro';
import SocialLinks from './SocialLinks.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor, routeKeyFromPath, type RouteKey } from '../i18n/routes';
import { business } from '../data/business';
import { services } from '../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = routeKeyFromPath(Astro.url.pathname);
const isHome = current === 'home';

// Services dropdown entries (pillars → pages, programs → PT-page anchors).
const serviceLinks = services.map((s) => ({
  href: hrefFor(s.route, lang) + (s.hash ? `#${s.hash}` : ''),
  name: t.services[s.id].name,
  desc: t.services[s.id].desc,
  accent: s.accent,
  featured: s.featured ?? false,
}));
const servicesActive = current === 'servicesPT' || current === 'servicesAccident';

const otherNav: { key: RouteKey; label: string }[] = [
  { key: 'conditions', label: t.nav.conditions },
  { key: 'firstVisit', label: t.nav.firstVisit },
  { key: 'team', label: t.nav.team },
  { key: 'contact', label: t.nav.contact },
];
const isActive = (k: RouteKey) => current === k;
---

<header class="site-header" data-home={isHome ? 'true' : 'false'}>
  <div class="mx-auto flex h-full max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href={hrefFor('home', lang)} class="flex items-center text-ink" aria-label={t.site.name}>
      <span class="logo-stack block">
        <img src="/logo-lockup.png" alt={t.site.name} width="687" height="220" class="logo-dark h-14 w-auto sm:h-16" />
        <img src="/logo-lockup-white.png" alt="" aria-hidden="true" width="687" height="220" class="logo-light h-14 w-auto sm:h-16" />
      </span>
    </a>

    {/* Desktop nav */}
    <nav aria-label="Primary" class="hidden items-center gap-0.5 lg:flex">
      {/* Services dropdown */}
      <div class="nav-dropdown" data-dropdown>
        <button
          type="button"
          class:list={['nav-link nav-dropdown-btn rounded-md px-3 py-2 text-sm font-semibold', servicesActive && 'is-active']}
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-btn
        >
          {t.nav.services}
          <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-dropdown-panel" data-dropdown-panel>
          <ul role="list" class="grid gap-1">
            {serviceLinks.map((s) => (
              <li>
                <a href={s.href} class="nav-dropdown-item">
                  <span class:list={['nav-dropdown-dot', s.accent === 'ember' ? 'is-ember' : 'is-field']} aria-hidden="true"></span>
                  <span class="min-w-0">
                    <span class="block font-bold text-ink">{s.name}</span>
                    <span class="mt-0.5 block text-xs leading-snug text-ink-faint">{s.desc}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {otherNav.map((item) => (
        <a
          href={hrefFor(item.key, lang)}
          aria-current={isActive(item.key) ? 'page' : undefined}
          class:list={['nav-link rounded-md px-3 py-2 text-sm font-semibold', isActive(item.key) && 'is-active']}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {business.hasPhone && (
        <a href={`tel:${business.phone}`} class="nav-phone hidden text-sm font-bold xl:inline">
          {business.phoneDisplay}
        </a>
      )}
      <a href={hrefFor('contact', lang)} class="btn btn-field nav-cta hidden text-sm sm:inline-flex">{t.nav.book}</a>
      <div class="nav-lang">
        <LanguageSelector />
      </div>

      {/* Mobile disclosure (works without JS) */}
      <details class="group relative lg:hidden">
        <summary
          class="nav-toggle flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg"
          aria-label={t.nav.menu}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" class="group-open:hidden" />
            <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block" />
          </svg>
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.6rem)] max-h-[78vh] w-72 overflow-y-auto rounded-2xl border border-ink/10 bg-paper p-2.5 shadow-[var(--shadow-lift)]">
          <nav aria-label="Mobile" class="flex flex-col">
            <p class="px-3 pb-1 pt-2 text-xs font-bold uppercase tracking-widest text-ink-faint">{t.nav.services}</p>
            {serviceLinks.map((s) => (
              <a href={s.href} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-semibold text-ink-soft transition-colors hover:bg-ink/5 hover:text-ink">
                <span class:list={['nav-dropdown-dot', s.accent === 'ember' ? 'is-ember' : 'is-field']} aria-hidden="true"></span>
                {s.name}
              </a>
            ))}
            <span class="my-2 h-px bg-ink/10"></span>
            {otherNav.map((item) => (
              <a
                href={hrefFor(item.key, lang)}
                aria-current={isActive(item.key) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors',
                  isActive(item.key) ? 'bg-field-50 text-field-800' : 'text-ink-soft hover:bg-ink/5 hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            ))}
            <a href={hrefFor('contact', lang)} class="btn btn-field mt-2 text-sm">{t.nav.book}</a>
            <a href={business.hasPhone ? `tel:${business.phone}` : hrefFor('contact', lang)} class="mt-1 px-3 py-2 text-center text-sm font-bold text-ink">
              {business.hasPhone ? `${t.nav.call} ${business.phoneDisplay}` : t.nav.write}
            </a>
            <span class="my-2 h-px bg-ink/10"></span>
            <SocialLinks class="justify-center pb-1" />
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Transparent over the home hero, solid once you scroll past it. On every
  // other page the header is solid from the start. Plus the Services dropdown
  // (hover + click + keyboard). Re-runs after each View Transition.
  function initHeader() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;

    // --- transparent-over-hero ---
    const isHome = header.dataset.home === 'true';
    const hero = document.getElementById('hero');
    if (!isHome || !hero) {
      header.classList.remove('is-transparent');
    } else {
      const update = () => {
        const threshold = hero.offsetHeight - header.offsetHeight - 8;
        header.classList.toggle('is-transparent', window.scrollY < threshold);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }

    // --- Services dropdown ---
    const dropdown = header.querySelector<HTMLElement>('[data-dropdown]');
    const btn = dropdown?.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
    if (dropdown && btn) {
      const close = () => {
        dropdown.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      };
      const toggle = () => {
        const open = dropdown.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target as Node)) close();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
