---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { hrefFor } from '../i18n/routes';
import type { ConditionDef } from '../data/content';

interface Props {
  items: ConditionDef[];
}
const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul role="list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((c, i) => {
    const cond = t.conditions[c.id as keyof typeof t.conditions];
    return (
      <li class="reveal" style={`--reveal-delay:${i * 50}ms`}>
        <a
          href={hrefFor(c.route, lang)}
          class="group flex h-full items-center justify-between gap-3 rounded-2xl border border-ink/10 bg-paper p-5 transition-all hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-[var(--shadow-soft)]"
        >
          <span class="flex items-center gap-3">
            <span class={`h-2.5 w-2.5 shrink-0 rounded-full ${c.pillar === 'accident' ? 'bg-ember-500' : 'bg-field-500'}`} aria-hidden="true"></span>
            <span class="font-bold text-ink">{cond.name}</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-ink-faint transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </li>
    );
  })}
</ul>
