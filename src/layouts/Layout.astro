---
import '@fontsource-variable/archivo';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localeTags } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  /** Which page this is — drives canonical + hreflang (translated-slug map). */
  routeKey: RouteKey;
  ogImage?: string;
  /** Extra page-specific JSON-LD (FAQPage, MedicalTherapy, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
  /** Keep the page out of the index (thin/placeholder pages). Also drops it from the sitemap. */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, routeKey, ogImage, schema = [], noindex = false } = Astro.props;
// The header is fixed. The home hero sits beneath it (transparent overlay), so
// only non-home pages need top padding equal to the header height.
const isHome = routeKey === 'home';
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F2D4D" />
    <Seo title={title} description={description} routeKey={routeKey} ogImage={ogImage} noindex={noindex} />
    <JsonLd />
    {
      schema.map((s) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
      ))
    }
    {/* Smooth crossfade between locales / internal nav. */}
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t.nav.skip}
    </a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none" style={isHome ? undefined : 'padding-top: var(--header-h)'}>
      <slot />
    </main>
    <Footer />

    <script>
      // Kinetic-but-calm scroll reveal. Re-runs on every View Transition via
      // astro:page-load. On SPA navigations reveals appear instantly so they
      // never stack a second animation on top of the page crossfade.
      // Reveal-on-scroll. Runs on every navigation (astro:page-load gives us a
      // fresh DOM each time), so elements animate in as they enter the viewport.
      function initReveals() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveals);
    </script>
    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
  </body>
</html>
