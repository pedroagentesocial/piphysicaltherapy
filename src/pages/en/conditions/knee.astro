---
import Layout from '../../../layouts/Layout.astro';
import ConditionView from '../../../components/views/ConditionView.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { conditionMeta } from '../../../lib/conditionMeta';
import { conditionSchema } from '../../../lib/pageSchema';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const id = 'knee' as const;
const route = 'condKnee' as const;
const name = t.conditions[id].name;
const meta = conditionMeta(lang, name);
const schema = conditionSchema(t, Astro.site!, lang, route, name, meta.description);
---

<Layout title={meta.title} description={meta.description} routeKey={route} schema={schema}>
  <ConditionView id={id} />
</Layout>
