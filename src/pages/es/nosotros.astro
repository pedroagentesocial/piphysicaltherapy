---
import Layout from '../../layouts/Layout.astro';
import AboutView from '../../components/views/AboutView.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { aboutSchema } from '../../lib/pageSchema';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const schema = aboutSchema(t, Astro.site!, lang);
---

<Layout title={t.seo.team.title} description={t.seo.team.description} routeKey="team" schema={schema}>
  <AboutView />
</Layout>
